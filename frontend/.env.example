# Vite development-server proxy target. This is read by vite.config.js only;
# it is not exposed to browser JavaScript. Defaults to the deployed API.
AVERA_API_PROXY_TARGET=https://api.avera.clippit.click

# Optional: where the browser sends API calls. Leave unset to use the same-origin
# /api proxy. A build served from another origin can call the API directly, e.g.
# VITE_AVERA_API_BASE=https://api.avera.clippit.click (the API must allow that origin
# through AVERA_CORS_ORIGINS).
# VITE_AVERA_API_BASE=
