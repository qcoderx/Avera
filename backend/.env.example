# Copy this file to backend/.env. Never commit backend/.env.
# Supply an authorized OpenAI key locally; this same variable serves all agents.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: leave blank to keep the existing Ghost Test summary configuration disabled.
AVERA_GHOST_SUMMARY_MODEL=
# Explicit model used by Shaz's complaint parser and hypothesis investigator.
AVERA_OBSERVABILITY_MODEL=gpt-5.4-mini
# Optional comma-separated browser origins allowed to call the API directly
# (e.g. a hosted command centre). Leave blank to allow none. Exact origins only;
# '*' is rejected so browser access remains explicitly scoped.
AVERA_CORS_ORIGINS=
AVERA_DATABASE_URL=postgresql://avera_app@127.0.0.1:55432/avera_dev
AVERA_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
AVERA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
AVERA_KAFKA_SASL_MECHANISM=
AVERA_KAFKA_SASL_USERNAME=
AVERA_KAFKA_SASL_PASSWORD=
AVERA_KAFKA_CA_FILE=
