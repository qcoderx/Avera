# Copy this file to backend/.env. Never commit backend/.env.
# Supply an authorized OpenAI key locally; this same variable serves all agents.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: leave blank to keep the existing Ghost Test summary configuration disabled.
AVERA_GHOST_SUMMARY_MODEL=
# Explicit model used by Shaz's complaint parser and hypothesis investigator.
AVERA_OBSERVABILITY_MODEL=gpt-5.4-mini
